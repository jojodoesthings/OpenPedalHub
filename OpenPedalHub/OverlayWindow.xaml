<Window x:Class="OpenPedalHub.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenPedalHub"
        Title="OpenPedalHub overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        UseLayoutRounding="True" Foreground="{DynamicResource Fg}" FontFamily="{StaticResource Ui}" FontSize="12.5">
    <Window.Resources>
        <!-- A pedal tab: glossy pill in the pedal's colour, showing its live output. -->
        <Style x:Key="Tab" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="bd" CornerRadius="17" Background="{TemplateBinding Background}" BorderBrush="#55FFFFFF" BorderThickness="1"/>
                            <Border CornerRadius="16,16,0,0" Height="16" VerticalAlignment="Top" Margin="1,1,1,0" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#78FFFFFF" Offset="0"/>
                                        <GradientStop Color="#14FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter Margin="16,0,14,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#CCFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Small round glossy button for the bar. -->
        <Style x:Key="Mini" TargetType="Button" BasedOn="{StaticResource Orb}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <!-- Slightly see-through until the pointer is over it, so it stays out of the way while driving -->
    <StackPanel Margin="12">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Setter Property="Opacity" Value="0.86"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="1"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>

        <!-- The bar -->
        <Border HorizontalAlignment="Left" CornerRadius="23" Padding="6,5" Background="{DynamicResource Glass}"
                BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <!-- Drag handle; hidden while the position is locked -->
                <Border x:Name="Grip" Width="22" Height="34" Background="Transparent" Cursor="SizeAll" ToolTip="Drag to move. Lock the position in Settings."
                        MouseLeftButtonDown="Grip_Down" MouseMove="Grip_Move" MouseLeftButtonUp="Grip_Up">
                    <UniformGrid Rows="3" Columns="2" Width="10" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource Muted}"/>
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource Muted}"/>
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource Muted}"/>
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource Muted}"/>
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource Muted}"/>
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource Muted}"/>
                    </UniformGrid>
                </Border>

                <!-- Profile switcher -->
                <Button Style="{StaticResource Mini}" Content="&#xE76B;" Tag="silent" Click="Prev_Click" Margin="2,0,0,0" ToolTip="Previous profile"/>
                <TextBlock x:Name="ProfileText" Width="124" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" Margin="6,0"/>
                <Button Style="{StaticResource Mini}" Content="&#xE76C;" Tag="silent" Click="Next_Click" ToolTip="Next profile"/>

                <!-- Pedal tabs -->
                <ItemsControl x:Name="Tabs" Margin="10,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PedalViewModel}">
                            <ToggleButton Style="{StaticResource Tab}" Width="150" Margin="0,0,6,0" Background="{Binding HeaderBrush}"
                                          IsChecked="{Binding OverlayOpen}" ToolTip="Open or close this pedal's tuning panel">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding OutputText}" FontFamily="{StaticResource Mono}" FontWeight="SemiBold"
                                               Width="54" TextAlignment="Right"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                </DockPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Style="{StaticResource Mini}" Content="&#xE8A7;" Click="OpenApp_Click" Margin="2,0,2,0" ToolTip="Open the full OpenPedalHub window"/>
            </StackPanel>
        </Border>

        <!-- Tuning panels for whichever tabs are open -->
        <ItemsControl x:Name="Panels" HorizontalAlignment="Left">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:PedalViewModel}">
                    <Border Width="292" Margin="0,8,8,0" CornerRadius="14" Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource CardEdge}" BorderThickness="1"
                            Visibility="{Binding OverlayOpen, Converter={StaticResource Vis}}">
                        <Border.Effect>
                            <DropShadowEffect Color="{Binding Accent2Color}" BlurRadius="16" ShadowDepth="0" Opacity="0.45"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border CornerRadius="13,13,0,0" Background="{Binding HeaderBrush}">
                                <Grid>
                                    <Border CornerRadius="13,13,0,0" Height="17" VerticalAlignment="Top">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#78FFFFFF" Offset="0"/>
                                                <GradientStop Color="#1EFFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <DockPanel Margin="14,7" TextElement.Foreground="White">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding OutputText}" FontFamily="{StaticResource Display}" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Grid>
                            </Border>
                            <StackPanel Margin="14,12,14,14">
                                <local:CurveView Height="150" Margin="0,0,0,8"
                                                 Low="{Binding Low}" High="{Binding High}" Gamma="{Binding Gamma}"
                                                 Input="{Binding Input}" Points="{Binding Points}"
                                                 Accent="{Binding AccentColor}" Accent2="{Binding Accent2Color}"/>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Low, StringFormat={}{0:0.0} %}" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" Foreground="{Binding AccentText}"/>
                                    <TextBlock Text="Dead zone at rest"/>
                                </DockPanel>
                                <Slider Minimum="0" Maximum="40" SmallChange="0.1" LargeChange="1" Value="{Binding Low}" Foreground="{Binding AccentGradient}"/>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding High, StringFormat={}{0:0.0} %}" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" Foreground="{Binding AccentText}"/>
                                    <TextBlock Text="Dead zone at full press"/>
                                </DockPanel>
                                <Slider Minimum="0" Maximum="40" SmallChange="0.1" LargeChange="1" Value="{Binding High}" Foreground="{Binding AccentGradient}"/>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Gamma, StringFormat={}{0:0.00}}" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" Foreground="{Binding AccentText}"/>
                                    <TextBlock Text="Gamma (sensitivity)"/>
                                </DockPanel>
                                <Slider Minimum="0.3" Maximum="3" SmallChange="0.01" LargeChange="0.1" IsEnabled="{Binding UsesGamma}"
                                        Value="{Binding Gamma}" Foreground="{Binding AccentGradient}"/>
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Content="Reset" Style="{StaticResource Ghost}" Padding="12,4" Click="Reset_Click"/>
                                    <ToggleButton Content="Custom curve" Style="{StaticResource Switch}" HorizontalAlignment="Left"
                                                  IsChecked="{Binding Custom}" BorderBrush="{Binding AccentGradient}"/>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Window>
